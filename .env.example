# Project 6 application MUST implement docs/integration.md evaluation bridge.
PROJECT6_EVAL_URL=http://127.0.0.1:8000
PROJECT6_EVAL_TOKEN=
# External LLM judge uses provider credentials, passed to DeepEval (for example):
OPENAI_API_KEY=
# Database/artifact directory; path resolved against current process working directory
DEEPEVAL_DISABLE_DOTENV=1
RAGBENCH_HOME=results
# Required if Streamlit is exposed outside localhost:
RAGBENCH_ADMIN_TOKEN=
